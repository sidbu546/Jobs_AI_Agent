# Copy to .env and fill in your values
# Optional — only needed for cover letter drafting and LLM-based tailoring.
# Job ingestion + semantic matching works with NO API key (sentence-transformers, local).
ANTHROPIC_API_KEY=

# Database — SQLite for local dev, swap to Postgres+pgvector in prod
DATABASE_URL=sqlite:///./jobs.db
CHROMA_PERSIST_DIR=./.chroma

# USAJobs API (https://developer.usajobs.gov/)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=siddhank@bu.edu

# Matching thresholds
MATCH_SCORE_THRESHOLD=0.72
MAX_JOBS_PER_RUN=200

# Alerts — optional
SLACK_WEBHOOK_URL=

# Gmail outreach — optional, only needed to send recruiter emails from the app.
# Setup: turn on 2-Step Verification (myaccount.google.com/security), then
# create an App Password (myaccount.google.com/apppasswords) — use that
# 16-character code below, not your regular Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
